# ============================================================================
# SEO Audit Platform — environment example
# Copy to .env and fill in. NEVER commit .env or license data to the repo.
# ============================================================================

# --- Database (PostgreSQL) --------------------------------------------------
DATABASE_URL="postgresql://seo:seo@localhost:5432/seo_audit?schema=public"

# --- Redis / BullMQ ---------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- App --------------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"

# --- Screaming Frog SEO Spider (CLI, headless) ------------------------------
# Absolute path to the Screaming Frog CLI executable.
# Linux:   /usr/bin/screamingfrogseospider
# macOS:   /Applications/Screaming Frog SEO Spider.app/Contents/MacOS/ScreamingFrogSEOSpiderLauncher
# Windows: C:\Program Files (x86)\Screaming Frog SEO Spider\ScreamingFrogSEOSpiderCli.exe
# If empty or the file does not exist, the platform runs in MANUAL-IMPORT-ONLY mode.
SF_CLI_PATH=""

# Base folder where each crawl writes its exports (one sub-folder per job).
SF_EXPORT_DIR="./data/exports"

# Folder where uploaded CSV/ZIP files are stored.
UPLOAD_DIR="./data/uploads"

# Optional: path to a custom Screaming Frog .seospiderconfig file to apply to every crawl.
# Leave empty to use per-audit configuration only.
SF_DEFAULT_CONFIG=""

# Max wall-clock time (ms) before a crawl job is killed and marked as timeout.
SF_JOB_TIMEOUT_MS="3600000"

# Comma-separated export tabs and bulk exports requested from Screaming Frog.
# (Advanced — sensible defaults are used if left empty.)
SF_EXPORT_TABS="Internal:All,Response Codes:All,Page Titles:All,Meta Description:All,H1:All,H2:All,Canonicals:All,Directives:All,Hreflang:All,Images:Missing Alt Text,Structured Data:All"
SF_BULK_EXPORTS="Response Codes:Redirection (3xx) Inlinks,Response Codes:Client Error (4xx) Inlinks,Canonicals:Canonical Chains,Hreflang:All"

# NOTE: Screaming Frog license is provided at install/runtime on the host,
# NOT via this repo. Do not paste license keys here in committed files.
