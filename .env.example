# ─── Slack ────────────────────────────────────────────────────────────────────
# Socket Mode: nessun URL pubblico necessario.
# Bot User OAuth Token (xoxb-...)  -> OAuth & Permissions
SLACK_BOT_TOKEN=
# App-Level Token con scope connections:write (xapp-...) -> Basic Information
SLACK_APP_TOKEN=
# Signing Secret (usato solo se disabiliti il Socket Mode)
SLACK_SIGNING_SECRET=
# Nome del comando slash registrato su Slack (senza slash)
SLACK_COMMAND=seo-audit

# ─── Crawler ──────────────────────────────────────────────────────────────────
CRAWL_MAX_URLS=500
CRAWL_MAX_DEPTH=10
CRAWL_CONCURRENCY=5
CRAWL_DELAY_MS=200
CRAWL_TIMEOUT_MS=15000
CRAWL_RESPECT_ROBOTS=true
CRAWL_INCLUDE_SUBDOMAINS=false
CRAWL_USER_AGENT=SlackSeoAudit/1.0 (+https://example.com/bot)
# Timeout globale di un singolo job di audit (ms)
JOB_TIMEOUT_MS=900000
JOB_CONCURRENCY=2

# ─── PageSpeed Insights ─────────────────────────────────────────────────────
# Fonte dei dati di velocità (Lighthouse + Core Web Vitals reali).
# Funziona anche senza chiave; con la chiave (gratuita: Google Cloud Console ->
# API e servizi -> Credenziali -> Crea chiave API, con PageSpeed Insights API
# abilitata) si evita il rate limiting condiviso.
PAGESPEED_ENABLED=true
PAGESPEED_API_KEY=
PAGESPEED_TIMEOUT_MS=60000

# ─── Google Search Console ──────────────────────────────────────────────────
# Percorso della chiave JSON del service account (vedi README, sezione GSC).
# Una chiave copre piu account Search Console: basta aggiungere la sua email come
# utente alle proprieta, in ciascun account. Verifica la copertura con: npm run gsc
# Piu chiavi (solo se un cliente fornisce la propria) separate da punto e virgola.
# Il service account va aggiunto come utente nella proprieta Search Console.
# Gli export del report Link (non coperto dall'API) vanno in data/gsc/<dominio>/
GSC_CREDENTIALS_PATH=

# ─── Report ───────────────────────────────────────────────────────────────────
REPORT_BRAND_NAME=Diamondweb
REPORT_BRAND_COLOR="#1d4ed8"
# Percorso di un logo PNG/SVG locale da inserire in copertina (opzionale)
REPORT_LOGO_PATH=
# Cartella dove vengono salvati snapshot JSON, PDF e CSV
DATA_DIR=./data
# Percorso Chromium di sistema (obbligatorio in Docker, opzionale in locale)
PUPPETEER_EXECUTABLE_PATH=

# ─── Log ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development
