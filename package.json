{
  "name": "slack-seo-audit",
  "version": "1.0.0",
  "private": true,
  "description": "Slack slash command that crawls a domain, runs a full technical SEO audit and uploads a professional PDF report to the channel.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "audit": "tsx src/cli.ts",
    "demo": "tsx src/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:watch": "tsx watch src/bot.ts"
  },
  "dependencies": {
    "@slack/bolt": "^3.19.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^4.5.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "puppeteer": "^23.6.0",
    "robots-parser": "^3.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
