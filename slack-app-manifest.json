{
  "display_information": {
    "name": "SEO Audit",
    "description": "Genera un SEO audit tecnico completo e lo consegna in PDF",
    "background_color": "#1d4ed8"
  },
  "features": {
    "bot_user": {
      "display_name": "SEO Audit",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/seo-audit",
        "description": "Scansiona un dominio e genera un SEO audit tecnico in PDF",
        "usage_hint": "dominio.it [--max N] [--depth N]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": ["commands", "chat:write", "files:write", "files:read"]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
